        {{-- Alpine.js Component --}}
        <script>
            function fieldReview() {
                return {
                    fields: @js($fields->values()),
                    reviewStats: {
                        total: 0,
                        reviewed: 0,
                        correct: 0,
                        incorrect: 0,
                        pending: 0,
                        percentage: 0
                    },
                    
                    init() {
                        this.updateStats();
                    },
                    
                    updateStats() {
                        this.reviewStats.total = this.fields.length;
                        this.reviewStats.correct = this.fields.filter(f => f.is_correct === true).length;
                        this.reviewStats.incorrect = this.fields.filter(f => f.is_correct === false).length;
                        this.reviewStats.reviewed = this.reviewStats.correct + this.reviewStats.incorrect;
                        this.reviewStats.pending = this.reviewStats.total - this.reviewStats.reviewed;
                        this.reviewStats.percentage = Math.round((this.reviewStats.reviewed / this.reviewStats.total) * 100);
                    },
                    
                    async markAllCorrect() {
                        if (!confirm('Mark all fields as correct?')) return;
                        
                        try {
                            const response = await fetch('{{ route('supplyhead.properties.mark-all-correct', $property) }}', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'X-CSRF-TOKEN': '{{ csrf_token() }}'
                                }
                            });
                            
                            if (response.ok) {
                                this.fields.forEach(field => field.is_correct = true);
                                this.updateStats();
                                alert('All fields marked as correct');
                            }
                        } catch (error) {
                            alert('Error: ' + error.message);
                        }
                    }
                };
            }
            
            function fieldRow(field) {
                return {
                    field: field,
                    status: field.is_correct,
                    remark: field.remark || '',
                    showingRemarkInput: false,
                    
                    showRemarkInput() {
                        this.showingRemarkInput = true;
                        this.status = false;
                    },
                    
                    cancelRemark() {
                        this.showingRemarkInput = false;
                        this.status = this.field.is_correct;
                        this.remark = this.field.remark || '';
                    },
                    
                    async markCorrect() {
                        await this.saveReview(true, null);
                    },
                    
                    async saveIncorrect() {
                        if (!this.remark.trim()) {
                            alert('Remark is required for incorrect fields');
                            return;
                        }
                        await this.saveReview(false, this.remark);
                    },
                    
                    async saveReview(isCorrect, remark) {
                        try {
                            const response = await fetch('{{ route('supplyhead.properties.review-field', $property) }}', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'X-CSRF-TOKEN': '{{ csrf_token() }}'
                                },
                                body: JSON.stringify({
                                    field_name: this.field.name,
                                    field_label: this.field.label,
                                    field_value: this.field.value,
                                    is_correct: isCorrect,
                                    remark: remark
                                })
                            });
                            
                            if (response.ok) {
                                this.status = isCorrect;
                                this.field.is_correct = isCorrect;
                                this.field.remark = remark;
                                this.showingRemarkInput = false;
                                this.$dispatch('field-reviewed');
                            }
                        } catch (error) {
                            alert('Error: ' + error.message);
                        }
                    }
                };
            }
            
            // Listen for field-reviewed events to update stats
            document.addEventListener('alpine:initialized', () => {
                document.addEventListener('field-reviewed', () => {
                    Alpine.store('fieldReview')?.updateStats();
                });
            });
        </script>
    @endif

